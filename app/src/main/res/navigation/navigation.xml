<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/homeFragment">

    <action
        android:id="@+id/actionHome"
        app:destination="@id/homeFragment"
        app:popUpTo="@navigation/navigation"
        app:popUpToInclusive="true"
        app:launchSingleTop="true"/>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.pesquiseme.hotmart.presentation.home.HomeFragment"
        tools:layout="@layout/fragment_home"/>

    <action
        android:id="@+id/actionMap"
        app:destination="@id/mapFragment"
        app:popUpTo="@navigation/navigation"
        app:popUpToInclusive="true"
        app:launchSingleTop="true"/>
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.pesquiseme.hotmart.presentation.map.MapFragment"
        tools:layout="@layout/fragment_map"/>

    <action
        android:id="@+id/actionProfile"
        app:destination="@id/profileFragment"
        app:popUpTo="@navigation/navigation"
        app:popUpToInclusive="true"
        app:launchSingleTop="true"/>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.pesquiseme.hotmart.presentation.profile.ProfileFragment"
        tools:layout="@layout/fragment_profile"/>

</navigation>